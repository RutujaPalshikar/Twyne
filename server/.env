PORT=5000
MONGODB_URI=
# Comma-separated list of allowed frontend origins (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Optional overrides for presence timing (milliseconds)
# HEARTBEAT_INTERVAL_MS=5000
# INACTIVE_TIMEOUT_MS=15000
# SWEEP_INTERVAL_MS=5000

# ---- File transfer (all optional; defaults shown) ----
# MAX_FILE_SIZE_MB=100            maximum size of one file
# CHUNK_SIZE_BYTES=2097152        2 MB pieces
# BUFFER_WINDOW_CHUNKS=8          sender may be at most 8 chunks (16 MB) ahead of the slowest receiver
# RECEIVER_POLL_MS=1000           how often receivers look for new files
# RECEIVER_IDLE_TIMEOUT_MS=10000  a receiver that stops polling this long is dropped from its transfers
# SENDER_STALL_TIMEOUT_MS=30000   an unfinished upload with no sender activity this long is aborted
# TRANSFER_SWEEP_INTERVAL_MS=2000
